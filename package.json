{
  "name": "shield-captcha-enterprise",
  "version": "4.2.0",
  "private": true,
  "description": "Unified Dual-Defense Bot Engine & Developer Portal (Next.js, Node.js, Python, TypeScript)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "node backend-node/server.js",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "start:backend": "node backend-node/server.js",
    "keys": "node scripts/generate-keys.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "install:frontend": "npm --prefix frontend install"
  },
  "keywords": [
    "captcha",
    "turnstile",
    "jigsaw-puzzle",
    "nextjs",
    "typescript",
    "bot-defense",
    "proof-of-work",
    "kinematics"
  ],
  "author": "ShieldCaptcha Enterprise Team",
  "license": "MIT"
}
