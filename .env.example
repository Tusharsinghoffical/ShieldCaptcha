# =====================================================================
# ShieldCaptcha Enterprise - Production Environment Variables
# Copy this file to .env and customize secrets before launching
# =====================================================================

# Server Ports & Hosts
PORT=3000
FRONTEND_PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ---------------------------------------------------------------------
# Cryptographic Keys (Generate with: node scripts/generate-keys.js)
# ---------------------------------------------------------------------
# Public Site Identifier (Embedded in client HTML widgets)
SITE_KEY=pub_shield_live_production_01928374

# Master Verification Secret (Kept strictly on your application servers)
SITE_SECRET=sec_shield_live_production_99887766554433221100aabbccddeeff

# HMAC Signing Key for verification tokens & Proof-of-Work salts
CAPTCHA_SECRET=replace_with_64_character_hex_cryptographic_secret_key_here

# Diagnostics Secret for deep diagnostic metrics on /api/health
HEALTH_CHECK_SECRET=replace_with_strong_random_health_token_2026

# ---------------------------------------------------------------------
# Reverse Proxy & Networking
# ---------------------------------------------------------------------
# Set to 'true' if running behind NGINX, Cloudflare, Traefik, or AWS ALB
TRUST_PROXY=true

# Allowed CORS Origins (Comma separated or * for public APIs)
ALLOWED_ORIGIN=*

# URL to Core Defense Engine (Used by Next.js frontend proxy)
CAPTCHA_BACKEND_URL=http://backend:3000
